{
  "name": "origami-loaders",
  "version": "0.2.0",
  "description": "Loaders that fold: ten 3D origami models, from a paper crane to a jumping frog, as live SVG. One web component, zero dependencies.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "loader",
    "spinner",
    "progress",
    "origami",
    "svg",
    "web-component",
    "custom-element",
    "animation",
    "paper",
    "crane"
  ],
  "homepage": "https://origami-loaders.vercel.app",
  "bugs": {
    "url": "https://github.com/rishiashar/origami-loaders/issues"
  },
  "author": "rishiashar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rishiashar/origami-loaders.git"
  },
  "main": "./dist/origami-loaders.js",
  "module": "./dist/origami-loaders.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/origami-loaders.js",
      "default": "./dist/origami-loaders.js"
    },
    "./check": {
      "types": "./dist/types/check.d.ts",
      "import": "./dist/check.js",
      "default": "./dist/check.js"
    },
    "./iife": "./dist/origami-loaders.iife.js",
    "./package.json": "./package.json"
  },
  "unpkg": "dist/origami-loaders.iife.js",
  "jsdelivr": "dist/origami-loaders.iife.js",
  "files": [
    "dist",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "npm run build && node -e \"console.log(process.cwd()+'/demo/dist/index.html')\"",
    "capture": "node scripts/capture.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@paper-design/shaders": "0.0.82",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
